# dependencias y datos de ejecución
node_modules/
# Todo lo que se guarda en data/ en ejecución (cuentas, sesiones, historial, audios) es PERSONAL: no se versiona.
# Solo se versionan los géneros y las semillas.
data/*
!data/genres.json
!data/seed/
*.tmp
# respaldos de DATA_DIR (scripts/respaldo.js): datos personales
respaldos/

# secretos
.env
.env.*

# documento con datos internos de red (MACs, DNS, direcciones): se queda en el equipo, no se publica
docs/SOLICITUD-IP-FIJA.md

# sistema
.DS_Store
Thumbs.db

# paquete de instalación: Node y yt-dlp se añaden al armar el zip, no se versionan
vendor/
# ...salvo las fuentes e iconos del panel (Inter y Font Awesome), que sí son parte de la app
!public/assets/vendor/

# datos del equipo de desarrollo (destinos, usuarios, accesos): solo en este PC, nunca en el repo
CLAUDE.local.md
.local/
